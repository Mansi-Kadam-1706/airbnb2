
<% layout('layouts/boilerplate') -%>

<script>
  const mapToken = "<%= mapToken %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="container mt-4">
  <div class="row">
    <div class="col-8 offset-2">

      <h3 class="mb-3"><%= listing.title %></h3>

      <div class="card">
        <img src="<%= listing.image.url %>" 
             class="card-img-top" 
             alt="listing_image"
             style="height: 25rem; object-fit: cover;" />

        <div class="card-body">
          <p class="card-text">Owned by <%= listing.owner.username %></p>

          <p class="card-text">
            <%= listing.description %>
          </p>

          <p class="card-text">
            <b>&#8377;
              <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
            </b> 
          </p>

          <p class="card-text">
            <%= listing.location %>, <%= listing.country %>
          </p>
        </div>
      </div>

      <!-- EDIT / DELETE -->
      <div class="mt-3 d-flex gap-2">
        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-danger">Delete</button>
          </form>
        <% } %>
      </div>

      <!-- BOOKING FORM -->
      <div class="mt-4">
        <h4>Book this place</h4>

        <% if (currUser) { %>
          <form action="/listings/<%= listing._id %>/book" method="POST">

            <div class="mb-3">
              <label class="form-label">Check-in</label>
              <input 
                type="date" 
                name="checkIn" 
                class="form-control" 
                required 
                min="<%= new Date().toISOString().split('T')[0] %>"
              >
            </div>

            <div class="mb-3">
              <label class="form-label">Check-out</label>
              <input 
                type="date" 
                name="checkOut" 
                class="form-control" 
                required
              >
            </div>

            <button class="btn btn-success">Book Now</button>
          </form>

        <% } else { %>
          <p>Please <a href="/login">login</a> to book this place.</p>
        <% } %>
      </div>

      <!-- REVIEW SECTION -->
      <div class="mt-4">

        <% if (currUser) { %>
          <hr>
          <h4>Leave a Review</h4>

          <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">

            <div class="mb-3 mt-3">
              <label class="form-label">Rating</label>

              <fieldset class="starability-slot">
                <input type="radio" name="review[rating]" value="1" checked />

                <input type="radio" id="rate1" name="review[rating]" value="1" />
                <label for="rate1">1</label>

                <input type="radio" id="rate2" name="review[rating]" value="2" />
                <label for="rate2">2</label>

                <input type="radio" id="rate3" name="review[rating]" value="3" />
                <label for="rate3">3</label>

                <input type="radio" id="rate4" name="review[rating]" value="4" />
                <label for="rate4">4</label>

                <input type="radio" id="rate5" name="review[rating]" value="5" />
                <label for="rate5">5</label>
              </fieldset>
            </div>

            <div class="mb-3 mt-3">
              <label class="form-label">Comments</label>
              <textarea name="review[comment]" rows="5" class="form-control" required></textarea>
              <div class="invalid-feedback">Please enter a comment.</div>
            </div>

            <button class="btn btn-outline-dark mb-3">Submit</button>
          </form>
        <% } %>

        <hr/>

        <!-- SHOW REVIEWS -->
        <% if (listing.reviews.length > 0) { %>
          <div class="row">
            <h4>All Reviews</h4>

            <% for (let review of listing.reviews) { %>
              <div class="review-card col-5 mb-2 mt-2 ms-2">
                <div class="card-body mt-1">
                  <h5>@<%= review.author.username %></h5>
                  <p data-rating="<%= review.rating %>"></p>
                  <p><%= review.comment %></p>
                </div>

                <% if (currUser && currUser._id.equals(review.author._id)) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-dark mb-1">Delete</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } %>

      </div>

    </div>

    <!-- MAP -->
    <div class="col-6 offset-2">
      <h3>Where you'll be</h3>
      <br>
      <div id="map"></div>
    </div>

  </div>

  <br><br>
</div>

<script src="/js/map.js"></script>